{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RawWeave",
  "version": "0.1.0",
  "identifier": "com.rawweave.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../frontend"
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RawWeave",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
